digraph "top" {
label="top";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="LED2", color="black", fontcolor="black"];
n2 [ shape=octagon, label="LED1", color="black", fontcolor="black"];
n3 [ shape=octagon, label="BUT2", color="black", fontcolor="black"];
n4 [ shape=octagon, label="BUT1", color="black", fontcolor="black"];
c8 [ shape=record, label="{{<p5> a|<p6> b}|NAND\nNand|{<p7> out}}",  ];
c8:p7:e -> n2:w [colorscheme="dark28", color="5", fontcolor="5", label=""];
n3:e -> c8:p6:w [colorscheme="dark28", color="1", fontcolor="1", label=""];
n4:e -> c8:p5:w [colorscheme="dark28", color="1", fontcolor="1", label=""];
}
